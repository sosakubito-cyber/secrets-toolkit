#!/bin/bash
# secret-pull <Bitwardenの項目名> <キーチェーン名> [--notes]
#
#   Bitwarden から値を取り出し、そのまま macOS キーチェーンへ格納する。
#   値は画面にもログにも出ない。スマホで登録した新しいキーを Mac に取り込む用途。
#
#   --notes を付けると password 欄ではなく「セキュアメモ」欄から取得する
#   （サービスアカウントJSON など複数行の値はこちら）。
#
#   事前に secret-bootstrap を1回実行しておくこと。
set -euo pipefail
set +x

item="${1:-}"; kcname="${2:-}"; mode="${3:-}"
if [ -z "$item" ] || [ -z "$kcname" ]; then
  echo "usage: secret-pull <Bitwardenの項目名> <キーチェーン名> [--notes]" >&2
  exit 2
fi

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }

BW_CLIENTID="$(kc bw/client-id)"     || true
BW_CLIENTSECRET="$(kc bw/client-secret)" || true
BW_PASSWORD="$(kc bw/master-password)"   || true
if [ -z "${BW_CLIENTID:-}" ] || [ -z "${BW_PASSWORD:-}" ]; then
  echo "エラー: Bitwarden の認証情報が未設定です。Mac の前で secret-bootstrap を実行してください" >&2
  exit 1
fi
export BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD

cleanup() { bw lock >/dev/null 2>&1 || true; unset BW_PASSWORD BW_CLIENTSECRET; }
trap cleanup EXIT INT TERM

bw login --check >/dev/null 2>&1 || bw login --apikey --quiet >/dev/null 2>&1 || {
  echo "エラー: bw login に失敗しました" >&2; exit 1; }

SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
[ -n "$SESSION" ] || { echo "エラー: bw unlock に失敗しました" >&2; exit 1; }

bw sync --session "$SESSION" >/dev/null 2>&1 || true

if [ "$mode" = "--notes" ]; then
  value="$(bw get item "$item" --session "$SESSION" 2>/dev/null | jq -r '.notes // empty')"
else
  value="$(bw get password "$item" --session "$SESSION" 2>/dev/null || true)"
fi

if [ -z "$value" ]; then
  echo "エラー: Bitwarden に項目 '$item' が見つからない、または値が空です" >&2
  echo "  （複数行の値なら --notes を試してください）" >&2
  exit 1
fi

printf '%s' "$value" | secret-put "$kcname"
unset value

# registry へ登録名を記録（秘密は含まない）
REG="$HOME/.config/secrets/registry.txt"
grep -qxF "$kcname" "$REG" 2>/dev/null || printf '%s\n' "$kcname" >> "$REG"

echo "  Bitwarden '$item' -> キーチェーン '$kcname' に取り込みました" >&2
