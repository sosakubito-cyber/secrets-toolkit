#!/bin/bash
# secret-push <キーチェーン名> <配布先> [<配布先> ...]
#
#   キーチェーンの値を各サービスへ反映する。ローテーション後の一括更新用。
#   値は標準入力経由で各CLIに渡すため、画面・ログ・プロセス引数に出ない。
#
#   配布先の書式:
#     cf:<wranglerプロジェクトのディレクトリ>:<SECRET名>   Cloudflare Workers
#     gh:<owner/repo>:<SECRET名>                          GitHub Actions
#
#   例:
#     secret-push dev/openai/answer-prompter \
#       "cf:$HOME/Documents/Business Chance/answer-prompter:OPENAI_API_KEY" \
#       "gh:sosakubito-cyber/opportunity-radar:OPENAI_API_KEY"
set -euo pipefail
set +x

name="${1:-}"; shift || true
if [ -z "$name" ] || [ $# -eq 0 ]; then
  echo "usage: secret-push <キーチェーン名> <配布先> [<配布先> ...]" >&2
  echo "  配布先: cf:<dir>:<SECRET名> / gh:<owner/repo>:<SECRET名>" >&2
  exit 2
fi

attrs="$(security find-generic-password -a "$USER" -s "$name" 2>/dev/null)" || {
  echo "エラー: キーチェーンに '$name' がありません" >&2; exit 1; }
value="$(security find-generic-password -a "$USER" -s "$name" -w 2>/dev/null)" || {
  echo "エラー: '$name' の読み出しに失敗しました" >&2; exit 1; }
case "$attrs" in
  *'"icmt"<blob>="b64"'*) value="$(printf '%s' "$value" | openssl base64 -d -A)" ;;
esac
unset attrs

fail=0
for dest in "$@"; do
  kind="${dest%%:*}"; rest="${dest#*:}"
  target="${rest%:*}"; secname="${rest##*:}"

  case "$kind" in
    cf)
      if [ ! -d "$target" ]; then
        printf '  \033[31mFAIL\033[0m  cf %s (ディレクトリなし)\n' "$target"; fail=1; continue
      fi
      if printf '%s' "$value" | (cd "$target" && wrangler secret put "$secname" >/dev/null 2>&1); then
        printf '  \033[32mOK\033[0m    Cloudflare Workers  %-24s <- %s\n' "$secname" "$(basename "$target")"
      else
        printf '  \033[31mFAIL\033[0m  Cloudflare Workers  %-24s (wrangler login 済みか確認)\n' "$secname"; fail=1
      fi
      ;;
    gh)
      if printf '%s' "$value" | gh secret set "$secname" --repo "$target" >/dev/null 2>&1; then
        printf '  \033[32mOK\033[0m    GitHub Actions      %-24s <- %s\n' "$secname" "$target"
      else
        printf '  \033[31mFAIL\033[0m  GitHub Actions      %-24s (%s)\n' "$secname" "$target"; fail=1
      fi
      ;;
    *)
      printf '  \033[31mFAIL\033[0m  未知の配布先種別: %s\n' "$kind"; fail=1
      ;;
  esac
done
unset value

echo
if [ $fail -eq 0 ]; then
  echo "全ての配布先へ反映しました"
else
  echo "!! 一部失敗しました。上記を確認してください"
fi
echo "注: Google Apps Script のスクリプトプロパティは自動反映できません（手動更新が必要）"
exit $fail
