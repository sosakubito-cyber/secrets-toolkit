#!/bin/bash
# secrets-run [profile] -- <command> [args...]
#
#   ~/.config/secrets/<profile>.map に書かれた対応表に従い、
#   macOS キーチェーンから値を取り出して環境変数に入れ、コマンドを実行する。
#   値は画面にもログにも出ない（子プロセスの環境変数にのみ渡る）。
#
#   profile を省略した場合、カレントディレクトリから上位へ .secrets-profile を探す。
#
#   対応表の書式:
#     OPENAI_API_KEY=dev/openai/answer-prompter          # 値を環境変数に入れる
#     GOOGLE_APPLICATION_CREDENTIALS=@file:dev/gcp/sa    # 一時ファイルに書き出しパスを渡す
#
#   例:
#     secrets-run answer-prompter -- npm test
#     secrets-run -- python scripts/grade.py      # .secrets-profile を自動検出
set -euo pipefail
set +x

CONF_DIR="$HOME/.config/secrets"
TMPROOT=""

cleanup() {
  # 必ず 0 を返すこと。EXIT トラップ内の最終コマンドのステータスが
  # スクリプトの終了コードを上書きしてしまうため
  # （@file: を使うプロファイルで終了コードが常に 1 になる不具合があった）。
  if [ -n "${TMPROOT:-}" ] && [ -d "$TMPROOT" ]; then
    rm -rf "$TMPROOT"
  fi
  return 0
}
trap cleanup EXIT INT TERM

die() { echo "secrets-run: $*" >&2; exit 1; }

profile=""
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
  profile="$1"; shift
fi
if [ "${1:-}" = "--" ]; then shift; fi
[ $# -gt 0 ] || die "実行するコマンドが指定されていません。使い方: secrets-run [profile] -- <command>"

# --- profile の自動検出 ---
if [ -z "$profile" ]; then
  d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -f "$d/.secrets-profile" ]; then
      profile="$(tr -d '[:space:]' < "$d/.secrets-profile")"
      break
    fi
    d="$(dirname "$d")"
  done
fi
[ -n "$profile" ] || die "profile が指定されておらず、.secrets-profile も見つかりません"

map="$CONF_DIR/$profile.map"
[ -f "$map" ] || die "対応表がありません: $map"

# --- 対応表を読み、キーチェーンから環境変数へ ---
loaded=0
files=0
missing=()

while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
  [ -n "$line" ] || continue
  case "$line" in *=*) ;; *) die "対応表の書式が不正です: $line" ;; esac

  var="${line%%=*}"; svc="${line#*=}"
  var="${var%"${var##*[![:space:]]}"}"
  svc="${svc#"${svc%%[![:space:]]*}"}"

  as_file=0
  case "$svc" in @file:*) as_file=1; svc="${svc#@file:}" ;; esac

  if ! attrs="$(security find-generic-password -a "$USER" -s "$svc" 2>/dev/null)"; then
    missing+=("$var -> $svc")
    continue
  fi
  if ! val="$(security find-generic-password -a "$USER" -s "$svc" -w 2>/dev/null)"; then
    missing+=("$var -> $svc")
    continue
  fi
  # 格納形式はコメント欄(icmt)に記録されている
  case "$attrs" in
    *'"icmt"<blob>="b64"'*) val="$(printf '%s' "$val" | openssl base64 -d -A)" ;;
  esac
  unset attrs

  if [ "$as_file" -eq 1 ]; then
    if [ -z "$TMPROOT" ]; then
      TMPROOT="$(mktemp -d "${TMPDIR:-/tmp}/secrets-run.XXXXXXXX")"
      chmod 700 "$TMPROOT"
    fi
    dest="$TMPROOT/${svc//\//_}"
    (umask 077; printf '%s\n' "$val" > "$dest")
    export "$var=$dest"
    files=$((files+1))
  else
    export "$var=$val"
    loaded=$((loaded+1))
  fi
  unset val
done < "$map"

if [ ${#missing[@]} -gt 0 ]; then
  echo "secrets-run: キーチェーンに見つからない項目があります:" >&2
  for m in "${missing[@]}"; do echo "  - $m" >&2; done
  exit 1
fi

echo "secrets-run: profile=$profile / 環境変数 ${loaded} 件, 一時ファイル ${files} 件を注入しました" >&2

if [ "$files" -gt 0 ]; then
  # 一時ファイルの後始末が必要なので exec せず子プロセスとして実行する
  "$@"
  rc=$?
  cleanup; TMPROOT=""
  exit $rc
else
  exec "$@"
fi
