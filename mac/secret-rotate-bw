#!/bin/bash
# secret-rotate-bw — Bitwarden の API キー（client_id / client_secret）を入れ替える。
#
#   再発行そのものは Bitwarden の Web 金庫でしか行えない（bw CLI に該当コマンドが無い）。
#   このスクリプトは「再発行後の反映」を安全に行う:
#     1. 現在の認証情報を控える
#     2. 新しい値を入力（画面には出ない）
#     3. 新しい値で実際にログイン・解錠・金庫読み出しまで確認
#     4. 成功したときだけキーチェーンを更新
#     5. 失敗したら古い認証情報へ自動で巻き戻す（締め出し防止）
set -euo pipefail
set +x

if [ ! -t 0 ]; then
  echo "エラー: 対話端末で実行してください（リモート/自動実行は不可）" >&2
  echo "理由: 新しい認証情報をチャット経由で渡すと会話ログに残るため" >&2
  exit 1
fi

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }
put() { printf '%s' "$2" | secret-put "$1" >/dev/null; }

OLD_ID="$(kc bw/client-id)"; OLD_SECRET="$(kc bw/client-secret)"
BW_PASSWORD="$(kc bw/master-password)"
if [ -z "$OLD_ID" ] || [ -z "$BW_PASSWORD" ]; then
  echo "エラー: secret-bootstrap が未実行です" >&2; exit 1
fi
export BW_PASSWORD

cat <<'MSG'
Bitwarden APIキーの入れ替えを行います。

まず Web 金庫で再発行してください（このスクリプトからは実行できません）:
  https://vault.bitwarden.com  ->  設定 -> セキュリティ -> キー -> 「APIキーの再作成」

再発行すると新しい client_id / client_secret が表示されます。
その画面を開いたまま、以下に入力してください（入力は画面に表示されません）。

MSG

printf '新しい client_id: '
read -rs NEW_ID; echo
printf '新しい client_secret: '
read -rs NEW_SECRET; echo

if [ -z "$NEW_ID" ] || [ -z "$NEW_SECRET" ]; then
  echo "エラー: 空の入力です。中止しました（変更なし）" >&2; exit 1
fi
if [ "$NEW_ID" = "$OLD_ID" ] && [ "$NEW_SECRET" = "$OLD_SECRET" ]; then
  echo "入力が現在の値と同じです。再発行がまだ反映されていない可能性があります。中止しました（変更なし）" >&2
  exit 1
fi

echo
echo "== 新しい認証情報で実際に接続できるか確認 =="
bw logout >/dev/null 2>&1 || true
export BW_CLIENTID="$NEW_ID" BW_CLIENTSECRET="$NEW_SECRET"

ok=0
if bw login --apikey --quiet >/dev/null 2>&1; then
  S="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
  if [ -n "$S" ] && bw list items --session "$S" >/dev/null 2>&1; then
    n="$(bw list items --session "$S" 2>/dev/null | jq 'length')"
    echo "  接続成功（金庫の ${n} 件を読み出せました）"
    ok=1
  fi
fi

if [ "$ok" -ne 1 ]; then
  echo "  \033[31m新しい認証情報で接続できませんでした\033[0m" >&2
  echo "== 古い認証情報へ巻き戻します ==" >&2
  bw logout >/dev/null 2>&1 || true
  export BW_CLIENTID="$OLD_ID" BW_CLIENTSECRET="$OLD_SECRET"
  if bw login --apikey --quiet >/dev/null 2>&1; then
    echo "  巻き戻し成功（キーチェーンは変更していません）" >&2
  else
    echo "  !! 巻き戻しにも失敗しました。Web金庫で再度APIキーを再作成し、もう一度実行してください" >&2
  fi
  bw lock >/dev/null 2>&1 || true
  exit 1
fi

echo
echo "== キーチェーンを更新 =="
put bw/client-id "$NEW_ID"
put bw/client-secret "$NEW_SECRET"
echo "  bw/client-id と bw/client-secret を更新しました"

# 平文原本に残っていた旧APIキーの控えは、内容が古くなったことを記録
if [ -f "$HOME/.secrets-archive/bitwarden_API_keys.txt" ]; then
  echo
  echo "注意: ~/.secrets-archive/bitwarden_API_keys.txt の内容は無効な旧キーになりました。"
  echo "      削除して構いません（キーチェーンに新しい値があります）。"
fi

bw lock >/dev/null 2>&1 || true
unset BW_PASSWORD BW_CLIENTSECRET NEW_SECRET OLD_SECRET

echo
echo "===== 入れ替え完了 ====="
echo "確認: secret-sync を実行すると、新しい認証情報で金庫にアクセスできます。"
