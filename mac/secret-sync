#!/bin/bash
# secret-sync — Bitwarden の金庫とキーチェーンを突き合わせて自動同期する。
#
#   スマホで項目をいくつ追加しても、これ1回でキーチェーンへ取り込まれる。
#   値は一切表示しない。
#
#   やること:
#     1. 金庫にあってキーチェーンに無いもの -> 自動で取り込む
#     2. キーチェーンにあって金庫に無いもの -> 報告のみ（消さない）
#     3. 命名規則に従っていない項目名     -> 報告のみ
#     4. 項目名の前後に空白がある         -> 自動で修正
#
#   --dry-run で確認のみ（書き込みを一切しない）
set -uo pipefail
set +x

DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

REG="$HOME/.config/secrets/registry.txt"
TYPES='api-key|api-token|service-account|app-password|webhook-url|recovery-codes|bundle'

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }
BW_CLIENTID="$(kc bw/client-id)" || true
BW_CLIENTSECRET="$(kc bw/client-secret)" || true
BW_PASSWORD="$(kc bw/master-password)" || true
[ -n "${BW_PASSWORD:-}" ] || { echo "エラー: secret-bootstrap が未実行です" >&2; exit 1; }
export BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD

cleanup() { bw lock >/dev/null 2>&1 || true; unset BW_PASSWORD BW_CLIENTSECRET; return 0; }
trap cleanup EXIT INT TERM

bw login --check >/dev/null 2>&1 || bw login --apikey --quiet >/dev/null 2>&1 || {
  echo "エラー: bw login に失敗しました" >&2; exit 1; }
SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
[ -n "$SESSION" ] || { echo "エラー: bw unlock に失敗しました" >&2; exit 1; }
export BW_SESSION="$SESSION"
echo "同期中..." >&2
bw sync >/dev/null 2>&1 || true

items="$(bw list items 2>/dev/null)"

# ---- 4. 項目名の前後の空白を修正 ----
fixed=0
while IFS=$'\t' read -r id nm; do
  [ -n "${id:-}" ] || continue
  clean="$(printf '%s' "$nm" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  if [ "$DRY" -eq 1 ]; then
    printf '  [dry-run] 空白修正: [%s] -> [%s]\n' "$nm" "$clean"; fixed=$((fixed+1)); continue
  fi
  nj="$(printf '%s' "$items" | jq -c --arg i "$id" --arg c "$clean" '.[] | select(.id==$i) | .name=$c')"
  printf '%s' "$nj" | bw encode | bw edit item "$id" >/dev/null 2>&1 \
    && { printf '  空白修正: [%s] -> [%s]\n' "$nm" "$clean"; fixed=$((fixed+1)); }
done < <(printf '%s' "$items" | jq -r '.[] | select(.name != (.name|sub("^\\s+";"")|sub("\\s+$";""))) | "\(.id)\t\(.name)"')
if [ "$fixed" -gt 0 ] && [ "$DRY" -eq 0 ]; then
  bw sync >/dev/null 2>&1 || true
  items="$(bw list items 2>/dev/null)"
fi

# ---- 1. 金庫 -> キーチェーン ----
echo
echo "【1】金庫にあってキーチェーンに無いもの"
added=0
while IFS=$'\t' read -r nm typ; do
  [ -n "${nm:-}" ] || continue
  if security find-generic-password -a "$USER" -s "$nm" >/dev/null 2>&1; then continue; fi
  if [ "$DRY" -eq 1 ]; then printf '  [dry-run] 取り込む: %s\n' "$nm"; added=$((added+1)); continue; fi

  if [ "$typ" = "1" ]; then
    val="$(printf '%s' "$items" | jq -r --arg n "$nm" '.[] | select(.name==$n) | .login.password // ""')"
  else
    val="$(printf '%s' "$items" | jq -r --arg n "$nm" '.[] | select(.name==$n) | .notes // ""')"
  fi
  if [ -z "$val" ]; then printf '  \033[33mスキップ\033[0m %s (値が空)\n' "$nm"; continue; fi
  if printf '%s' "$val" | secret-put "$nm" >/dev/null 2>&1; then
    grep -qxF "$nm" "$REG" 2>/dev/null || printf '%s\n' "$nm" >> "$REG"
    printf '  \033[32m取り込み\033[0m %s\n' "$nm"; added=$((added+1))
  else
    printf '  \033[31m失敗\033[0m %s\n' "$nm"
  fi
  unset val
done < <(printf '%s' "$items" | jq -r '.[] | "\(.name)\t\(.type)"')
[ "$added" -eq 0 ] && echo "  （なし・すべて取り込み済み）"

# ---- 2. キーチェーン -> 金庫（報告のみ） ----
echo
echo "【2】キーチェーンにあって金庫に無いもの（消しません）"
miss=0
while IFS= read -r n; do
  n="${n%%#*}"; n="${n#"${n%%[![:space:]]*}"}"; n="${n%"${n##*[![:space:]]}"}"
  [ -n "$n" ] || continue
  case "$n" in bundle/bitwarden/*) continue ;; esac   # 循環依存のため意図的に金庫へ入れない
  if ! printf '%s' "$items" | jq -e --arg n "$n" 'any(.[]; .name==$n)' >/dev/null 2>&1; then
    printf '  \033[33m金庫に無い\033[0m %s\n' "$n"; miss=$((miss+1))
  fi
done < "$REG"
[ "$miss" -eq 0 ] && echo "  （なし）"

# ---- 3. 命名規則チェック ----
echo
echo "【3】命名規則 <種別>/<サービス>/<用途> に従っていない項目"
bad=0
while IFS= read -r nm; do
  [ -n "${nm:-}" ] || continue
  printf '  \033[33m要修正\033[0m %s\n' "$nm"; bad=$((bad+1))
done < <(printf '%s' "$items" | jq -r --arg t "^($TYPES)/[^/]+/.+$" '.[] | select((.name|test($t))|not) | .name')
[ "$bad" -eq 0 ] && echo "  （なし・全項目が規則に従っています）"

# ---- フォルダ未設定 ----
echo
echo "【4】フォルダ未設定の項目"
nof=0
while IFS= read -r nm; do
  [ -n "${nm:-}" ] || continue
  printf '  \033[33mフォルダなし\033[0m %s\n' "$nm"; nof=$((nof+1))
done < <(printf '%s' "$items" | jq -r '.[] | select(.folderId == null) | .name')
[ "$nof" -eq 0 ] && echo "  （なし）"

unset items
echo
echo "取り込み ${added} 件 / 金庫に無い ${miss} 件 / 名前要修正 ${bad} 件 / フォルダ未設定 ${nof} 件"
