#!/bin/bash
# secret-verify <name> <file> [plain|firstline|rtf]
#   キーチェーンの値と原本ファイルが同一かをSHA-256で照合する。
#   秘密の値もハッシュ値も出力しない。「一致」「不一致」のみ。
set -uo pipefail
set +x

name="${1:-}"; file="${2:-}"; mode="${3:-plain}"
if [ -z "$name" ] || [ -z "$file" ]; then
  echo "usage: secret-verify <name> <file> [plain|firstline|rtf]" >&2; exit 2
fi
[ -f "$file" ] || { printf '  \033[31mNOFILE\033[0m %s\n' "$file"; exit 1; }

trim() { local v; v="$(cat)"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"; printf '%s' "$v"; }

case "$mode" in
  rtf)       hf=$(textutil -convert txt -stdout "$file" 2>/dev/null | trim | shasum -a 256 | cut -d' ' -f1) ;;
  firstline) hf=$(head -n 1 "$file"                     | trim | shasum -a 256 | cut -d' ' -f1) ;;
  *)         hf=$(cat "$file"                           | trim | shasum -a 256 | cut -d' ' -f1) ;;
esac

attrs="$(security find-generic-password -a "$USER" -s "$name" 2>/dev/null)" || {
  printf '  \033[31m未登録\033[0m %s\n' "$name"; exit 1; }
val="$(security find-generic-password -a "$USER" -s "$name" -w 2>/dev/null)" || {
  printf '  \033[31m読出失敗\033[0m %s\n' "$name"; exit 1; }
case "$attrs" in
  *'"icmt"<blob>="b64"'*) val="$(printf '%s' "$val" | openssl base64 -d -A)" ;;
esac
hk=$(printf '%s' "$val" | trim | shasum -a 256 | cut -d' ' -f1)
unset val attrs

if [ "$hf" = "$hk" ]; then
  printf '  \033[32m一致\033[0m   %-46s -> %s\n' "$(basename "$file")" "$name"; exit 0
else
  printf '  \033[31m不一致\033[0m %-46s -> %s\n' "$(basename "$file")" "$name"; exit 1
fi
