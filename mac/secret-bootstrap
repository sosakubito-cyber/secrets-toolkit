#!/bin/bash
# secret-bootstrap — Bitwarden 連携の初回設定（Mac の前で1回だけ実行する）
#
#   Bitwarden の認証情報をキーチェーンに登録し、ヘッドレス解錠が通ることを確認する。
#   ここで入力した値は画面に表示されず、シェル履歴にも残らない。
#
#   事前準備:
#     1. iPhone/Web で Bitwarden の「APIキー専用アカウント」を作る
#        （自動解錠する金庫に個人のパスワードを入れないため、個人用とは分ける）
#     2. Web 版 → 設定 → セキュリティ → キー → 「APIキーを表示」で
#        client_id と client_secret を控える
set -euo pipefail
set +x

if [ ! -t 0 ]; then
  echo "エラー: このスクリプトは対話端末で実行してください（リモート/自動実行は不可）" >&2
  echo "理由: マスターパスワードをチャット経由で渡すと会話ログに残るため" >&2
  exit 1
fi

put() { printf '%s' "$2" | secret-put "$1"; }

echo "Bitwarden 連携の初回設定を行います。入力内容は画面に表示されません。"
echo

printf 'Bitwarden のメールアドレス: '
read -r BW_EMAIL
printf 'client_id: '
read -rs BW_CLIENTID; echo
printf 'client_secret: '
read -rs BW_CLIENTSECRET; echo
printf 'マスターパスワード: '
read -rs BW_PASSWORD; echo
printf 'マスターパスワード（確認）: '
read -rs BW_PASSWORD2; echo

if [ "$BW_PASSWORD" != "$BW_PASSWORD2" ]; then
  echo "エラー: マスターパスワードが一致しません" >&2; exit 1
fi
unset BW_PASSWORD2

echo
echo "== ログイン確認 =="
export BW_CLIENTID BW_CLIENTSECRET
if bw login --apikey --quiet 2>/dev/null; then
  echo "  ログイン成功"
elif bw login --check >/dev/null 2>&1; then
  echo "  すでにログイン済み"
else
  echo "エラー: bw login に失敗しました。client_id / client_secret を確認してください" >&2
  exit 1
fi

echo "== ヘッドレス解錠の確認 =="
export BW_PASSWORD
SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
if [ -z "$SESSION" ]; then
  echo "エラー: bw unlock に失敗しました" >&2; exit 1
fi
# セッションが本当に有効か（既知のリグレッション対策で実際に金庫を触って確かめる）
if ! bw list items --session "$SESSION" >/dev/null 2>&1; then
  echo "エラー: セッションは返りましたが金庫が解錠されていません。" >&2
  echo "  これは bw 2026.3.0 / 2026.4.1 の既知不具合です。以下でピン留めしてください:" >&2
  echo "    brew uninstall bitwarden-cli && npm install -g @bitwarden/cli@2026.1.0" >&2
  bw lock >/dev/null 2>&1 || true
  exit 1
fi
echo "  解錠成功（金庫の読み出しまで確認）"

echo "== キーチェーンへ保存 =="
put bw/email         "$BW_EMAIL"
put bw/client-id     "$BW_CLIENTID"
put bw/client-secret "$BW_CLIENTSECRET"
put bw/master-password "$BW_PASSWORD"

bw lock >/dev/null 2>&1 || true
unset BW_PASSWORD BW_CLIENTID BW_CLIENTSECRET BW_EMAIL SESSION

echo
echo "完了しました。以降はリモート（スマホ）からでも次が使えます:"
echo "    secret-pull <Bitwardenの項目名> <キーチェーン名>"
