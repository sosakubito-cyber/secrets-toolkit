#!/bin/bash
# secret-check [name ...]
#   キーチェーンに登録されているかを確認する。値は絶対に出力しない。
#   引数なしのときは ~/.config/secrets/registry.txt の全件を確認する。
set -uo pipefail
set +x

CONF_DIR="$HOME/.config/secrets"
REGISTRY="$CONF_DIR/registry.txt"

# registry.txt は「登録に成功した名前」の台帳なので、そこだけを見ると検査がほぼ必ず通る
# （自己成就。Windows 版も同じ形の欠陥を持っていて a5d37e0 で直した）。
# 本当に知りたいのは「.map が参照する名前が実在するか」なので、そちらを先に検査する。
names=("$@")
srcs=()
seen=""
add_name() {  # <名前> <出どころ>
  case "$seen" in *"|$1|"*) return 0 ;; esac
  seen="$seen|$1|"
  names+=("$1"); srcs+=("$2")
}

if [ ${#names[@]} -eq 0 ]; then
  # 1) 各プロファイルの .map が参照する名前（これが実行時に必要になる本体）
  for m in "$CONF_DIR"/*.map; do
    [ -e "$m" ] || continue
    prof="$(basename "$m" .map)"
    while IFS= read -r l || [ -n "$l" ]; do
      l="${l%%#*}"
      l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
      [ -n "$l" ] || continue
      case "$l" in *=*) ;; *) continue ;; esac
      svc="${l#*=}"
      svc="${svc#"${svc%%[![:space:]]*}"}"; svc="${svc%"${svc##*[![:space:]]}"}"
      svc="${svc#@file:}"
      [ -n "$svc" ] && add_name "$svc" "$prof.map"
    done < "$m"
  done

  # 2) 台帳にあるが、どの .map からも参照されていないもの
  if [ -f "$REGISTRY" ]; then
    while IFS= read -r l; do
      l="${l%%#*}"
      l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
      [ -n "$l" ] && add_name "$l" "registry"
    done < "$REGISTRY"
  fi

  if [ ${#names[@]} -eq 0 ]; then
    echo "検査対象がありません（$CONF_DIR に .map も registry.txt もありません）" >&2
    exit 1
  fi
else
  for _ in "${names[@]}"; do srcs+=("引数"); done
fi

rc=0
i=0
for n in "${names[@]}"; do
  src="${srcs[$i]}"; i=$((i+1))
  # -w を付けないので値は出力されない（属性の存在確認のみ）
  if security find-generic-password -a "$USER" -s "$n" >/dev/null 2>&1; then
    printf '  \033[32mOK\033[0m    %-46s %s\n' "$n" "$src"
  else
    printf '  \033[31mMISS\033[0m  %-46s %s\n' "$n" "$src"
    rc=1
  fi
done
exit $rc
