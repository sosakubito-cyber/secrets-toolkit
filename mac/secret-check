#!/bin/bash
# secret-check [name ...]
#   キーチェーンに登録されているかを確認する。値は絶対に出力しない。
#   引数なしのときは ~/.config/secrets/registry.txt の全件を確認する。
set -uo pipefail
set +x

REGISTRY="$HOME/.config/secrets/registry.txt"

names=("$@")
if [ ${#names[@]} -eq 0 ]; then
  if [ ! -f "$REGISTRY" ]; then
    echo "registry がありません: $REGISTRY" >&2
    exit 1
  fi
  while IFS= read -r l; do
    l="${l%%#*}"
    l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
    [ -n "$l" ] && names+=("$l")
  done < "$REGISTRY"
fi

rc=0
for n in "${names[@]}"; do
  # -w を付けないので値は出力されない（属性の存在確認のみ）
  if security find-generic-password -a "$USER" -s "$n" >/dev/null 2>&1; then
    printf '  \033[32mOK\033[0m    %s\n' "$n"
  else
    printf '  \033[31mMISS\033[0m  %s\n' "$n"
    rc=1
  fi
done
exit $rc
