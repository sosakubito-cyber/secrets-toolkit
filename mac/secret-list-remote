#!/bin/bash
# secret-list-remote — Bitwarden 金庫の「項目名」だけを一覧する。値は一切出力しない。
#   secret-pull で名前が合っているか確かめる用途。
set -euo pipefail
set +x

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }

BW_CLIENTID="$(kc bw/client-id)" || true
BW_CLIENTSECRET="$(kc bw/client-secret)" || true
BW_PASSWORD="$(kc bw/master-password)" || true
if [ -z "${BW_CLIENTID:-}" ] || [ -z "${BW_PASSWORD:-}" ]; then
  echo "エラー: 未設定です。secret-bootstrap を実行してください" >&2; exit 1
fi
export BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD

cleanup() { bw lock >/dev/null 2>&1 || true; unset BW_PASSWORD BW_CLIENTSECRET; }
trap cleanup EXIT INT TERM

bw login --check >/dev/null 2>&1 || bw login --apikey --quiet >/dev/null 2>&1 || {
  echo "エラー: bw login に失敗しました" >&2; exit 1; }

SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
[ -n "$SESSION" ] || { echo "エラー: bw unlock に失敗しました" >&2; exit 1; }

echo "同期中..." >&2
bw sync --session "$SESSION" >/dev/null 2>&1 || true

items="$(bw list items --session "$SESSION" 2>/dev/null)" || {
  echo "エラー: 項目の取得に失敗しました" >&2; exit 1; }

folders="$(bw list folders --session "$SESSION" 2>/dev/null)"
n="$(printf '%s' "$items" | jq 'length')"
echo "金庫の項目数: $n"

# type: 1=ログイン 2=セキュアメモ 3=カード 4=ID
printf '%s' "$items" | jq -r --argjson f "${folders:-[]}" '
  ($f | map({key:(.id // "null"), value:.name}) | from_entries) as $fmap
  | .[]
  | [ ($fmap[(.folderId // "null")] // "(フォルダなし)"),
      .name,
      (if .type==1 then "ログイン" elif .type==2 then "メモ" elif .type==3 then "カード" else "ID" end)
    ] | @tsv' \
| sort | awk -F'\t' '
    { if ($1 != prev) { printf "\n  [%s]\n", $1; prev=$1 }
      printf "    %-40s %s\n", $2, $3 }'
unset items folders
