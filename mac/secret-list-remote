#!/bin/bash
# secret-list-remote — Bitwarden 金庫の「項目名」だけを一覧する。値は一切出力しない。
#   secret-pull で名前が合っているか確かめる用途。
set -euo pipefail
set +x

# --- Bitwarden セッション（排他ロック付き共通処理） ---
# 複数の Claude Code セッションが同時に bw を使うと、後発の `bw lock` が
# 先行セッションの鍵を壊し、エラーにならず空の結果が返る（2026-08 に実際に発生）。
# _bw-common.sh がロックと結果の妥当性検証をまとめて行う。
_SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$_SELF_DIR/_bw-common.sh"
trap 'bw_session_close' EXIT INT TERM
bw_session_open || exit 1
bw sync >/dev/null 2>&1 || true
SESSION="$BW_SESSION"

items="$(bw list items --session "$SESSION" 2>/dev/null)" || {
  echo "エラー: 項目の取得に失敗しました" >&2; exit 1; }

folders="$(bw list folders --session "$SESSION" 2>/dev/null)"
n="$(printf '%s' "$items" | jq 'length')"
echo "金庫の項目数: $n"

# type: 1=ログイン 2=セキュアメモ 3=カード 4=ID
printf '%s' "$items" | jq -r --argjson f "${folders:-[]}" '
  ($f | map({key:(.id // "null"), value:.name}) | from_entries) as $fmap
  | .[]
  | [ ($fmap[(.folderId // "null")] // "(フォルダなし)"),
      .name,
      (if .type==1 then "ログイン" elif .type==2 then "メモ" elif .type==3 then "カード" else "ID" end)
    ] | @tsv' \
| sort | awk -F'\t' '
    { if ($1 != prev) { printf "\n  [%s]\n", $1; prev=$1 }
      printf "    %-40s %s\n", $2, $3 }'
unset items folders
