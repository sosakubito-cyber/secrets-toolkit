#!/bin/bash
# secret-put <name>
#   標準入力から秘密の値を受け取り、macOS キーチェーンに登録する。
#   値は標準出力にも標準エラーにも一切出さない（文字数のみ報告）。
#
#   注意: security(1) は改行を含む値を -w で読み出すと16進エンコードして返すため、
#   単一行に収まらない値は base64 で格納し、コメント欄(-j)に "b64" と記録する。
#   読み出し側(secrets-run)はこのコメントを見てデコードする。
#
#   例: printf '%s' "$SECRET" | secret-put dev/openai/foo
set -euo pipefail
set +x

name="${1:-}"
if [ -z "$name" ]; then
  echo "usage: secret-put <name>   (値は標準入力から渡す)" >&2
  exit 2
fi

value="$(cat)"
value="${value#"${value%%[![:space:]]*}"}"
value="${value%"${value##*[![:space:]]}"}"

if [ -z "$value" ]; then
  echo "error: 空の値です ($name)" >&2
  exit 1
fi

# 単一行かつ制御文字を含まないなら平文格納（Keychain Access.app で読めるように）
enc="raw"
stored="$value"
case "$value" in
  *$'\n'*|*$'\r'*|*$'\t'*) enc="b64" ;;
esac
if [ "$enc" = "b64" ]; then
  stored="$(printf '%s' "$value" | openssl base64 -A)"
fi

if ! security add-generic-password \
      -U -a "$USER" -s "$name" -l "$name" \
      -D "API key (secret-put)" -j "$enc" -w "$stored" >/dev/null 2>&1; then
  echo "error: キーチェーン登録に失敗しました ($name)" >&2
  exit 1
fi

echo "  ok  $name  (${#value} 文字を登録 / 格納形式=$enc)" >&2
