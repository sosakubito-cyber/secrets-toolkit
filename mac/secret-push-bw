#!/bin/bash
# secret-push-bw [キーチェーン名 ...]
#
#   キーチェーンの秘密を Bitwarden の金庫へ登録（バックアップ）する。
#   引数なしなら registry.txt の全件。値は一切表示しない。
#
#   - 1行の値      -> 「ログイン」項目の password 欄
#   - 複数行の値    -> 「セキュアメモ」項目の notes 欄（取り出しは secret-pull --notes）
#   - 項目名はキーチェーン名と同一にする（secret-pull <名前> <名前> で戻せる）
#   - 同名の項目が既にある場合は上書きせずスキップする（多重登録の防止）
set -euo pipefail
set +x

FOLDER_NAME="_unassigned"
REGISTRY="$HOME/.config/secrets/registry.txt"

# --folder <名前> でプロジェクト用フォルダを指定する（省略時は _unassigned）
if [ "${1:-}" = "--folder" ]; then
  [ -n "${2:-}" ] || { echo "usage: secret-push-bw [--folder <フォルダ名>] [キーチェーン名 ...]" >&2; exit 2; }
  FOLDER_NAME="$2"; shift 2
fi

# --- Bitwarden セッション（排他ロック付き共通処理） ---
# 複数の Claude Code セッションが同時に bw を使うと、後発の `bw lock` が
# 先行セッションの鍵を壊し、エラーにならず空の結果が返る（2026-08 に実際に発生）。
# _bw-common.sh がロックと結果の妥当性検証をまとめて行う。
_SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$_SELF_DIR/_bw-common.sh"
trap 'bw_session_close' EXIT INT TERM
bw_session_open || exit 1
bw sync >/dev/null 2>&1 || true
SESSION="$BW_SESSION"

# --- 金庫へ入れてはいけない / 入れなくてよいもの ---
# secret-sync の【2】と同じ判断基準。あちらは「金庫に無くても異常ではない」として
# 報告から除外しているだけだが、こちらは実際に書き込むため、判断を厳しくする。
#
#   bundle/bitwarden/*  金庫を開ける鍵そのもの。ここにはマスターパスワードが入る。
#                       金庫に入れれば循環依存になり、かつ「金庫を開ける鍵が金庫の中」
#                       という最悪の置き方になる。名指しされても拒否する。
#   service-account/app-store-connect/*
#                       正本は bundle/app-store-connect/* のメモ欄。純PEMの実行時コピーを
#                       金庫にも置くと正本が2つになる。既定では対象外。名指しなら通す。
is_forbidden() { case "$1" in bundle/bitwarden/*) return 0 ;; *) return 1 ;; esac; }
is_local_only() { case "$1" in service-account/app-store-connect/*) return 0 ;; *) return 1 ;; esac; }

# --- 対象の決定 ---
names=("$@")
explicit=1
if [ ${#names[@]} -eq 0 ]; then
  explicit=0
  [ -f "$REGISTRY" ] || { echo "エラー: $REGISTRY がありません" >&2; exit 1; }
  while IFS= read -r l; do
    l="${l%%#*}"; l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
    [ -n "$l" ] && names+=("$l")
  done < "$REGISTRY"
fi

# --- フォルダの解決（作成は遅延させる）---
# 作成をループ前に行うと、全件が拒否・スキップされた実行でも空のフォルダだけが
# 金庫に残る。実際に1件目を登録する直前まで作らない。
_folders="$(bw_folders)" || {
  echo "エラー: 金庫のフォルダ一覧を取得できませんでした（重複作成を避けるため中止します）" >&2; exit 1; }
FOLDER_ID="$(printf '%s' "$_folders" | jq -r --arg n "$FOLDER_NAME" 'first(.[] | select(.name==$n) | .id) // ""')"
unset _folders

resolve_folder_id() {
  [ -n "$FOLDER_ID" ] && [ "$FOLDER_ID" != "null" ] && return 0
  FOLDER_ID="$(jq -n --arg n "$FOLDER_NAME" '{name:$n}' | bw encode | bw create folder 2>/dev/null | jq -r '.id // ""')"
  # 作成に失敗したまま進むと、全項目が不正な folderId を持って登録に失敗する
  [ -n "$FOLDER_ID" ] && [ "$FOLDER_ID" != "null" ] || {
    echo "エラー: フォルダ '$FOLDER_NAME' を作成できませんでした" >&2; exit 1; }
  echo "フォルダ '$FOLDER_NAME' を作成しました"
}

# 既存の項目名。生の `bw list items` は空文字を成功として返すため、bw_items を通す。
# ここが空に化けると下の重複チェックが素通りし、金庫に同名項目を作ってしまう。
_items="$(bw_items)" || {
  echo "エラー: 金庫の項目を取得できませんでした（多重登録を避けるため中止します）" >&2; exit 1; }
existing="$(printf '%s' "$_items" | jq -r '.[].name')"
unset _items

added=0; skipped=0; failed=0
for n in "${names[@]}"; do
  if is_forbidden "$n"; then
    printf '  \033[31m拒否\033[0m      %-40s (金庫を開ける鍵は金庫に入れない)\n' "$n"
    skipped=$((skipped+1)); continue
  fi
  if is_local_only "$n" && [ "$explicit" -eq 0 ]; then
    printf '  スキップ  %-40s (正本は bundle/app-store-connect/* のメモ欄)\n' "$n"
    skipped=$((skipped+1)); continue
  fi
  if printf '%s\n' "$existing" | grep -qxF "$n"; then
    printf '  スキップ  %-40s (同名の項目が既にある)\n' "$n"; skipped=$((skipped+1)); continue
  fi

  attrs="$(security find-generic-password -a "$USER" -s "$n" 2>/dev/null)" || {
    printf '  \033[31m失敗\033[0m      %-40s (キーチェーンに無い)\n' "$n"; failed=$((failed+1)); continue; }
  val="$(security find-generic-password -a "$USER" -s "$n" -w 2>/dev/null)" || {
    printf '  \033[31m失敗\033[0m      %-40s (読み出し不可)\n' "$n"; failed=$((failed+1)); continue; }
  case "$attrs" in *'"icmt"<blob>="b64"'*) val="$(printf '%s' "$val" | openssl base64 -d -A)" ;; esac

  # ここで初めてフォルダを用意する（登録するものが確定してから）
  resolve_folder_id

  # 名前の <種別>/<サービス>/... から、アプリ一覧に出す種別ラベルを組み立てる
  typ="${n%%/*}"; svc="${n#*/}"; svc="${svc%%/*}"
  case "$typ" in
    api-key)         label="APIキー" ;;
    api-token)       label="APIトークン" ;;
    service-account) label="サービスアカウントJSON" ;;
    app-password)    label="アプリパスワード" ;;
    webhook-url)     label="Webhook URL" ;;
    recovery-codes)  label="リカバリコード" ;;
    bundle)          label="複数値まとめ" ;;
    *)               label="$typ" ;;
  esac
  label="$label ($svc)"

  multiline=0
  case "$val" in *$'\n'*) multiline=1 ;; esac

  if [ "$multiline" -eq 1 ]; then
    json="$(jq -n --arg n "$n" --arg v "$val" --arg f "$FOLDER_ID" \
      '{type:2, name:$n, notes:$v, favorite:false, folderId:$f, secureNote:{type:0}}')"
    kind="セキュアメモ"
  else
    json="$(jq -n --arg n "$n" --arg v "$val" --arg f "$FOLDER_ID" --arg u "$label" \
      '{type:1, name:$n, notes:null, favorite:false, folderId:$f,
        login:{username:$u, password:$v, totp:null}}')"
    kind="ログイン"
  fi
  unset val attrs

  if printf '%s' "$json" | bw encode | bw create item >/dev/null 2>&1; then
    printf '  \033[32m登録\033[0m      %-40s (%s)\n' "$n" "$kind"; added=$((added+1))
  else
    printf '  \033[31m失敗\033[0m      %-40s (bw create item)\n' "$n"; failed=$((failed+1))
  fi
  unset json
done

bw sync >/dev/null 2>&1 || true
echo
echo "登録 ${added} 件 / スキップ ${skipped} 件 / 失敗 ${failed} 件"
exit $failed
