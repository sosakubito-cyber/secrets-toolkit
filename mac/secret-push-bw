#!/bin/bash
# secret-push-bw [キーチェーン名 ...]
#
#   キーチェーンの秘密を Bitwarden の金庫へ登録（バックアップ）する。
#   引数なしなら registry.txt の全件。値は一切表示しない。
#
#   - 1行の値      -> 「ログイン」項目の password 欄
#   - 複数行の値    -> 「セキュアメモ」項目の notes 欄（取り出しは secret-pull --notes）
#   - 項目名はキーチェーン名と同一にする（secret-pull <名前> <名前> で戻せる）
#   - 同名の項目が既にある場合は上書きせずスキップする（多重登録の防止）
set -euo pipefail
set +x

FOLDER_NAME="_unassigned"
REGISTRY="$HOME/.config/secrets/registry.txt"

# --folder <名前> でプロジェクト用フォルダを指定する（省略時は _unassigned）
if [ "${1:-}" = "--folder" ]; then
  [ -n "${2:-}" ] || { echo "usage: secret-push-bw [--folder <フォルダ名>] [キーチェーン名 ...]" >&2; exit 2; }
  FOLDER_NAME="$2"; shift 2
fi

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }

BW_CLIENTID="$(kc bw/client-id)" || true
BW_CLIENTSECRET="$(kc bw/client-secret)" || true
BW_PASSWORD="$(kc bw/master-password)" || true
[ -n "${BW_PASSWORD:-}" ] || { echo "エラー: secret-bootstrap が未実行です" >&2; exit 1; }
export BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD

cleanup() { bw lock >/dev/null 2>&1 || true; unset BW_PASSWORD BW_CLIENTSECRET; }
trap cleanup EXIT INT TERM

bw login --check >/dev/null 2>&1 || bw login --apikey --quiet >/dev/null 2>&1 || {
  echo "エラー: bw login に失敗しました" >&2; exit 1; }
SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null || true)"
[ -n "$SESSION" ] || { echo "エラー: bw unlock に失敗しました" >&2; exit 1; }
export BW_SESSION="$SESSION"
bw sync >/dev/null 2>&1 || true

# --- 対象の決定 ---
names=("$@")
if [ ${#names[@]} -eq 0 ]; then
  [ -f "$REGISTRY" ] || { echo "エラー: $REGISTRY がありません" >&2; exit 1; }
  while IFS= read -r l; do
    l="${l%%#*}"; l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
    [ -n "$l" ] && names+=("$l")
  done < "$REGISTRY"
fi

# --- フォルダを用意 ---
FOLDER_ID="$(bw list folders 2>/dev/null | jq -r --arg n "$FOLDER_NAME" '.[] | select(.name==$n) | .id' | head -n 1)"
if [ -z "$FOLDER_ID" ] || [ "$FOLDER_ID" = "null" ]; then
  FOLDER_ID="$(jq -n --arg n "$FOLDER_NAME" '{name:$n}' | bw encode | bw create folder 2>/dev/null | jq -r '.id')"
  echo "フォルダ '$FOLDER_NAME' を作成しました"
fi

existing="$(bw list items 2>/dev/null | jq -r '.[].name')"

added=0; skipped=0; failed=0
for n in "${names[@]}"; do
  if printf '%s\n' "$existing" | grep -qxF "$n"; then
    printf '  スキップ  %-40s (同名の項目が既にある)\n' "$n"; skipped=$((skipped+1)); continue
  fi

  attrs="$(security find-generic-password -a "$USER" -s "$n" 2>/dev/null)" || {
    printf '  \033[31m失敗\033[0m      %-40s (キーチェーンに無い)\n' "$n"; failed=$((failed+1)); continue; }
  val="$(security find-generic-password -a "$USER" -s "$n" -w 2>/dev/null)" || {
    printf '  \033[31m失敗\033[0m      %-40s (読み出し不可)\n' "$n"; failed=$((failed+1)); continue; }
  case "$attrs" in *'"icmt"<blob>="b64"'*) val="$(printf '%s' "$val" | openssl base64 -d -A)" ;; esac

  # 名前の <種別>/<サービス>/... から、アプリ一覧に出す種別ラベルを組み立てる
  typ="${n%%/*}"; svc="${n#*/}"; svc="${svc%%/*}"
  case "$typ" in
    api-key)         label="APIキー" ;;
    api-token)       label="APIトークン" ;;
    service-account) label="サービスアカウントJSON" ;;
    app-password)    label="アプリパスワード" ;;
    webhook-url)     label="Webhook URL" ;;
    recovery-codes)  label="リカバリコード" ;;
    bundle)          label="複数値まとめ" ;;
    *)               label="$typ" ;;
  esac
  label="$label ($svc)"

  multiline=0
  case "$val" in *$'\n'*) multiline=1 ;; esac

  if [ "$multiline" -eq 1 ]; then
    json="$(jq -n --arg n "$n" --arg v "$val" --arg f "$FOLDER_ID" \
      '{type:2, name:$n, notes:$v, favorite:false, folderId:$f, secureNote:{type:0}}')"
    kind="セキュアメモ"
  else
    json="$(jq -n --arg n "$n" --arg v "$val" --arg f "$FOLDER_ID" --arg u "$label" \
      '{type:1, name:$n, notes:null, favorite:false, folderId:$f,
        login:{username:$u, password:$v, totp:null}}')"
    kind="ログイン"
  fi
  unset val attrs

  if printf '%s' "$json" | bw encode | bw create item >/dev/null 2>&1; then
    printf '  \033[32m登録\033[0m      %-40s (%s)\n' "$n" "$kind"; added=$((added+1))
  else
    printf '  \033[31m失敗\033[0m      %-40s (bw create item)\n' "$n"; failed=$((failed+1))
  fi
  unset json
done

bw sync >/dev/null 2>&1 || true
echo
echo "登録 ${added} 件 / スキップ ${skipped} 件 / 失敗 ${failed} 件"
exit $failed
